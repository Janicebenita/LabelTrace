# Copy to .env for local development. Placeholders only: never commit real keys or passwords.
APP_ENV=development
DATABASE_URL=sqlite:///data/labeltrace.db
STORAGE_BACKEND=local

# ---- LabelTrace AI (optional). Without these the AI workspace still shows the deterministic
# ---- release gate, impact graph and remediation checklists; only the chat needs the key.
AGENT_ENABLED=0
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
AGENT_MODEL=claude-sonnet-5-5
# Hard limits (defaults shown)
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=40
AGENT_MAX_TOKENS=2500
AGENT_USER_LIMIT_PER_10_MIN=10
AGENT_DAILY_LIMIT=200
