          "password"
        ],
        "title": "Credentials"
      },
      "DemoDefect": {
        "properties": {
          "change_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Id"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "defect": {
            "type": "string",
            "enum": [
              "barcode",
              "missing",
              "identifier",
              "text",
              "overflow",
              "applicability"
            ],
            "title": "Defect"
          }
        },
        "type": "object",
        "required": [
          "defect"
        ],
        "title": "DemoDefect"
      },
      "Generate": {
        "properties": {
          "change_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Id"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "title": "Generate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Propose": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "reason"
        ],
        "title": "Propose"
      },
      "Review": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve",
            "default": true
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionBump": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "VersionBump"
      }
    }
  }
